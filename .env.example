# Variables read by docker-compose.yml. Copy this file to .env and fill in JWT_SECRET.
#
# Required: a random secret of at least 32 characters, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional overrides.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todo

# Host ports; change them if the defaults are already taken on your machine.
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
