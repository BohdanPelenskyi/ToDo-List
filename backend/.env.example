NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo
# Used by the integration tests and `sequelize-cli --env test`.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_test
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
# Reverse proxies in front of the API (0 when none); the Next.js rewrite counts as one.
TRUST_PROXY_HOPS=0
# Requests per 15 minutes per IP on /register and /login.
AUTH_RATE_LIMIT_MAX=20
# Defaults to true in production. Set to false only when serving over plain HTTP.
# COOKIE_SECURE=true
